{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dashboard: Streamlit",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "dashboard/app.py", "--server.port", "8501"],
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}/src", "PYTHONUTF8": "1"},
            "justMyCode": true
        },
        {
            "name": "Data: prepare and validate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/prepare_data.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}/src", "PYTHONUTF8": "1"},
            "console": "integratedTerminal"
        },
        {
            "name": "Reports: generate sample PDF and Excel",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_reports.py",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}/src", "PYTHONUTF8": "1"},
            "console": "integratedTerminal"
        },
        {
            "name": "Tests: pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v"],
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}/src"},
            "console": "integratedTerminal"
        }
    ]
}
